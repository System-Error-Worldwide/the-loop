{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "route.schema.json",
  "type": "object",
  "required": ["schema_version", "capability", "harness", "track", "environment_digest", "decided_at", "behavior_max_age_seconds", "requirements", "candidates", "selected_provider", "selected_source", "reason", "verified_at", "fallback_reason"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "capability": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"},
    "harness": {"enum": ["codex", "claude_code", "kimi_code", "opencode"]},
    "track": {"enum": ["code", "noncode"]},
    "environment_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "decided_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "behavior_max_age_seconds": {"type": "integer", "const": 86400},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["provider", "source", "compatibility", "capability_evidence", "description_score", "behavior_status", "behavior_observations", "rejection_reasons", "provenance_type"],
        "properties": {
          "provider": {"type": "string", "minLength": 1},
          "source": {"enum": ["installed", "bundled"]},
          "compatibility": {"type": "array", "items": {"enum": ["codex", "claude_code", "kimi_code", "opencode"]}, "uniqueItems": true},
          "capability_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "description_score": {"type": "number", "minimum": 0, "maximum": 1},
          "behavior_status": {"enum": ["verified", "failed", "denied", "unverified"]},
          "behavior_observations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["capability", "harness", "track", "environment_digest", "outcome", "observed_at", "evidence_id"],
              "properties": {
                "capability": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"},
                "harness": {"enum": ["codex", "claude_code", "kimi_code", "opencode"]},
                "track": {"enum": ["code", "noncode"]},
                "environment_digest": {"$ref": "common.schema.json#/$defs/digest"},
                "outcome": {"enum": ["passed", "failed", "denied", "unverified"]},
                "observed_at": {"$ref": "common.schema.json#/$defs/timestamp"},
                "evidence_id": {"$ref": "common.schema.json#/$defs/uuidV4"}
              },
              "additionalProperties": false
            },
            "uniqueItems": true
          },
          "rejection_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "provenance_type": {"enum": ["system-error-original", "system-error-rewrite", "upstream-dependency", "excluded"]}
        },
        "additionalProperties": false
      }
    },
    "selected_provider": {"type": "string", "minLength": 1},
    "selected_source": {"enum": ["installed", "bundled"]},
    "reason": {"type": "string", "minLength": 1},
    "verified_at": {"anyOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
    "fallback_reason": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
