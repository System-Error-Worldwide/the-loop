{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grant.schema.json",
  "type": "object",
  "required": ["schema_version", "grant_id", "level", "actor", "scope", "risks_shown", "confirmation_text", "confirmed_at", "expires_at", "revoked_at", "revoked_by", "permanent_invariants"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "grant_id": {"$ref": "common.schema.json#/$defs/uuidV4"},
    "level": {"enum": ["attended", "bounded", "scoped", "operational", "full"]},
    "actor": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "required": ["assets", "actions", "destinations", "exclusions"],
      "properties": {
        "assets": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "destinations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "exclusions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "risks_shown": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "confirmation_text": {"type": "string", "minLength": 1},
    "confirmed_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "expires_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "revoked_at": {"anyOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
    "revoked_by": {"type": ["string", "null"]},
    "permanent_invariants": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"enum": ["visible_authority", "audit_log", "evidence_required", "run_ownership", "leases", "external_kill_switch", "faithful_failure", "no_silent_elevation"]}
    }
  },
  "additionalProperties": false
}
