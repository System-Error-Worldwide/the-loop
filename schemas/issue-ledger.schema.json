{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "issue-ledger.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "issues", "updated_at"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "run_id": {"$ref": "common.schema.json#/$defs/uuidV4"},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue_id", "title", "severity", "blocking", "status", "requirement_ids", "evidence_ids", "reproduction", "owner", "attempt_count", "resolution", "regression_procedure", "created_at", "updated_at"],
        "properties": {
          "issue_id": {"$ref": "common.schema.json#/$defs/uuidV4"},
          "title": {"type": "string", "minLength": 1},
          "severity": {"enum": ["critical", "high", "medium", "low"]},
          "blocking": {"type": "boolean"},
          "status": {"enum": ["open", "acknowledged", "resolving", "verification_pending", "closed", "reopened", "deferred"]},
          "requirement_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "evidence_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuidV4"}, "uniqueItems": true},
          "reproduction": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "owner": {"anyOf": [{"$ref": "common.schema.json#/$defs/actor"}, {"type": "null"}]},
          "attempt_count": {"type": "integer", "minimum": 0},
          "resolution": {"type": ["string", "null"]},
          "regression_procedure": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
          "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
        },
        "additionalProperties": false
      }
    },
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "additionalProperties": false
}
