{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit-event.schema.json",
  "$defs": {
    "runCreatedData": {
      "type": "object", "required": ["objective"],
      "properties": {"objective": {"type": "string", "minLength": 1}}, "additionalProperties": false
    },
    "authorityGrantedData": {
      "type": "object", "required": ["grant_id", "level"],
      "properties": {
        "grant_id": {"$ref": "common.schema.json#/$defs/uuidV4"},
        "level": {"enum": ["attended", "bounded", "scoped", "operational", "full"]}
      }, "additionalProperties": false
    },
    "authorityRevokedData": {
      "type": "object", "required": ["grant_id", "revoked_at", "revoked_by"],
      "properties": {
        "grant_id": {"$ref": "common.schema.json#/$defs/uuidV4"},
        "revoked_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "revoked_by": {"type": "string", "minLength": 1}
      }, "additionalProperties": false
    },
    "leaseData": {
      "type": "object", "required": ["lease_id", "generation", "expires_at"],
      "properties": {
        "lease_id": {"$ref": "common.schema.json#/$defs/uuidV4"},
        "generation": {"type": "integer", "minimum": 0},
        "expires_at": {"$ref": "common.schema.json#/$defs/timestamp"}
      }, "additionalProperties": false
    },
    "routeSelectedData": {
      "type": "object", "required": ["capability", "selected_provider", "selected_source"],
      "properties": {
        "capability": {"type": "string", "minLength": 1},
        "selected_provider": {"type": "string", "minLength": 1},
        "selected_source": {"enum": ["installed", "bundled"]}
      }, "additionalProperties": false
    },
    "stageStartedData": {
      "type": "object", "required": ["stage"],
      "properties": {"stage": {"$ref": "common.schema.json#/$defs/stage"}}, "additionalProperties": false
    },
    "heartbeatData": {
      "type": "object", "required": ["stage", "status"],
      "properties": {
        "stage": {"$ref": "common.schema.json#/$defs/stage"},
        "status": {"enum": ["active", "waiting_approval", "waiting_external", "blocked", "failed", "halted_kill_switch", "complete", "cancelled"]}
      }, "additionalProperties": false
    },
    "evidenceRecordedData": {
      "type": "object", "required": ["evidence_id", "outcome"],
      "properties": {
        "evidence_id": {"$ref": "common.schema.json#/$defs/uuidV4"},
        "outcome": {"enum": ["passed", "failed", "blocked", "denied", "unverified"]}
      }, "additionalProperties": false
    },
    "issueOpenedData": {
      "type": "object", "required": ["issue_id", "severity"],
      "properties": {
        "issue_id": {"$ref": "common.schema.json#/$defs/uuidV4"},
        "severity": {"enum": ["critical", "high", "medium", "low"]}
      }, "additionalProperties": false
    },
    "issueTransitionedData": {
      "type": "object", "required": ["issue_id", "from_status", "to_status"],
      "properties": {
        "issue_id": {"$ref": "common.schema.json#/$defs/uuidV4"},
        "from_status": {"enum": ["open", "acknowledged", "resolving", "verification_pending", "closed", "reopened", "deferred"]},
        "to_status": {"enum": ["open", "acknowledged", "resolving", "verification_pending", "closed", "reopened", "deferred"]}
      }, "additionalProperties": false
    },
    "stageCompletedData": {
      "type": "object", "required": ["stage", "outcome"],
      "properties": {
        "stage": {"$ref": "common.schema.json#/$defs/stage"},
        "outcome": {"enum": ["passed", "failed", "blocked"]}
      }, "additionalProperties": false
    },
    "budgetReachedData": {
      "type": "object", "required": ["budget", "stage", "limit", "observed"],
      "properties": {
        "budget": {"enum": ["max_duration_seconds", "max_stage_attempts", "max_mutations", "max_external_actions", "max_cost_usd"]},
        "stage": {"anyOf": [{"$ref": "common.schema.json#/$defs/stage"}, {"type": "null"}]},
        "limit": {
          "anyOf": [
            {"type": "number", "minimum": 0},
            {"$ref": "common.schema.json#/$defs/money"},
            {"type": "null"}
          ]
        },
        "observed": {
          "anyOf": [
            {"type": "number", "minimum": 0},
            {"$ref": "common.schema.json#/$defs/money"}
          ]
        }
      }, "additionalProperties": false
    },
    "killSwitchDetectedData": {
      "type": "object", "required": ["path"],
      "properties": {"path": {"$ref": "common.schema.json#/$defs/configuredPath"}}, "additionalProperties": false
    },
    "recoveryStartedData": {
      "type": "object", "required": ["previous_generation", "new_generation", "reason"],
      "properties": {
        "previous_generation": {"type": ["integer", "null"], "minimum": 0},
        "new_generation": {"type": "integer", "minimum": 0},
        "reason": {"type": "string", "minLength": 1}
      }, "additionalProperties": false
    },
    "terminalData": {
      "type": "object", "required": ["reason"],
      "properties": {"reason": {"type": "string", "minLength": 1}}, "additionalProperties": false
    },
    "operationReservation": {
      "type": "object",
      "required": ["mutations", "external_actions", "cost_usd", "stage_attempt", "prior_cost_usd", "prior_stage"],
      "properties": {
        "mutations": {"type": "integer", "minimum": 0},
        "external_actions": {"type": "integer", "minimum": 0},
        "cost_usd": {"$ref": "common.schema.json#/$defs/money"},
        "stage_attempt": {"anyOf": [{"$ref": "common.schema.json#/$defs/stage"}, {"type": "null"}]},
        "prior_cost_usd": {"anyOf": [{"$ref": "common.schema.json#/$defs/money"}, {"type": "null"}]},
        "prior_stage": {"anyOf": [{"$ref": "common.schema.json#/$defs/stage"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "pendingOperation": {
      "oneOf": [
        {
          "type": "object", "required": ["operation_id", "completion_event_type", "completion_data", "effect", "reservation"],
          "properties": {
            "operation_id": {"$ref": "common.schema.json#/$defs/uuidV4"},
            "completion_event_type": {"const": "route_selected"},
            "completion_data": {"$ref": "#/$defs/routeSelectedData"},
            "effect": {"enum": ["local", "external"]},
            "reservation": {"$ref": "#/$defs/operationReservation"}
          }, "additionalProperties": false
        },
        {
          "type": "object", "required": ["operation_id", "completion_event_type", "completion_data", "effect", "reservation"],
          "properties": {
            "operation_id": {"$ref": "common.schema.json#/$defs/uuidV4"},
            "completion_event_type": {"const": "stage_started"},
            "completion_data": {"$ref": "#/$defs/stageStartedData"},
            "effect": {"enum": ["local", "external"]},
            "reservation": {"$ref": "#/$defs/operationReservation"}
          }, "additionalProperties": false
        },
        {
          "type": "object", "required": ["operation_id", "completion_event_type", "completion_data", "effect", "reservation"],
          "properties": {
            "operation_id": {"$ref": "common.schema.json#/$defs/uuidV4"},
            "completion_event_type": {"const": "evidence_recorded"},
            "completion_data": {"$ref": "#/$defs/evidenceRecordedData"},
            "effect": {"enum": ["local", "external"]},
            "reservation": {"$ref": "#/$defs/operationReservation"}
          }, "additionalProperties": false
        },
        {
          "type": "object", "required": ["operation_id", "completion_event_type", "completion_data", "effect", "reservation"],
          "properties": {
            "operation_id": {"$ref": "common.schema.json#/$defs/uuidV4"},
            "completion_event_type": {"const": "issue_opened"},
            "completion_data": {"$ref": "#/$defs/issueOpenedData"},
            "effect": {"enum": ["local", "external"]},
            "reservation": {"$ref": "#/$defs/operationReservation"}
          }, "additionalProperties": false
        },
        {
          "type": "object", "required": ["operation_id", "completion_event_type", "completion_data", "effect", "reservation"],
          "properties": {
            "operation_id": {"$ref": "common.schema.json#/$defs/uuidV4"},
            "completion_event_type": {"const": "issue_transitioned"},
            "completion_data": {"$ref": "#/$defs/issueTransitionedData"},
            "effect": {"enum": ["local", "external"]},
            "reservation": {"$ref": "#/$defs/operationReservation"}
          }, "additionalProperties": false
        },
        {
          "type": "object", "required": ["operation_id", "completion_event_type", "completion_data", "effect", "reservation"],
          "properties": {
            "operation_id": {"$ref": "common.schema.json#/$defs/uuidV4"},
            "completion_event_type": {"const": "stage_completed"},
            "completion_data": {"$ref": "#/$defs/stageCompletedData"},
            "effect": {"enum": ["local", "external"]},
            "reservation": {"$ref": "#/$defs/operationReservation"}
          }, "additionalProperties": false
        }
      ]
    },
    "operationReconciledData": {
      "type": "object", "required": ["operation_id", "effect", "outcome"],
      "properties": {
        "operation_id": {"$ref": "common.schema.json#/$defs/uuidV4"},
        "effect": {"enum": ["local", "external"]},
        "outcome": {"enum": ["known_not_started", "unknown"]}
      }, "additionalProperties": false
    },
    "stateProjection": {
      "type": "object",
      "required": ["run", "lease", "pending_operation"],
      "properties": {
        "run": {"$ref": "run.schema.json"},
        "lease": {"anyOf": [{"$ref": "lease.schema.json"}, {"type": "null"}]},
        "pending_operation": {"anyOf": [{"$ref": "#/$defs/pendingOperation"}, {"type": "null"}]}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema_version", "event_id", "sequence", "run_id", "lease_id", "lease_generation", "type", "actor", "at", "data", "projection", "previous_event_digest", "event_digest"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "event_id": {"$ref": "common.schema.json#/$defs/uuidV4"},
    "sequence": {"type": "integer", "minimum": 1},
    "run_id": {"$ref": "common.schema.json#/$defs/uuidV4"},
    "lease_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/uuidV4"}, {"type": "null"}]},
    "lease_generation": {"type": ["integer", "null"], "minimum": 0},
    "type": {"enum": ["run_created", "authority_granted", "authority_revoked", "lease_acquired", "lease_renewed", "route_selected", "stage_started", "heartbeat", "evidence_recorded", "issue_opened", "issue_transitioned", "stage_completed", "operation_intended", "operation_reconciled", "budget_reached", "kill_switch_detected", "recovery_started", "run_completed", "run_failed", "run_cancelled"]},
    "actor": {"$ref": "common.schema.json#/$defs/actor"},
    "at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "data": {"type": "object"},
    "projection": {"$ref": "#/$defs/stateProjection"},
    "previous_event_digest": {"anyOf": [{"$ref": "common.schema.json#/$defs/digest"}, {"type": "null"}]},
    "event_digest": {"$ref": "common.schema.json#/$defs/digest"}
  },
  "oneOf": [
    {"properties": {"type": {"const": "run_created"}, "data": {"$ref": "#/$defs/runCreatedData"}}},
    {"properties": {"type": {"const": "authority_granted"}, "data": {"$ref": "#/$defs/authorityGrantedData"}}},
    {"properties": {"type": {"const": "authority_revoked"}, "data": {"$ref": "#/$defs/authorityRevokedData"}}},
    {"properties": {"type": {"const": "lease_acquired"}, "data": {"$ref": "#/$defs/leaseData"}}},
    {"properties": {"type": {"const": "lease_renewed"}, "data": {"$ref": "#/$defs/leaseData"}}},
    {"properties": {"type": {"const": "route_selected"}, "data": {"$ref": "#/$defs/routeSelectedData"}}},
    {"properties": {"type": {"const": "stage_started"}, "data": {"$ref": "#/$defs/stageStartedData"}}},
    {"properties": {"type": {"const": "heartbeat"}, "data": {"$ref": "#/$defs/heartbeatData"}}},
    {"properties": {"type": {"const": "evidence_recorded"}, "data": {"$ref": "#/$defs/evidenceRecordedData"}}},
    {"properties": {"type": {"const": "issue_opened"}, "data": {"$ref": "#/$defs/issueOpenedData"}}},
    {"properties": {"type": {"const": "issue_transitioned"}, "data": {"$ref": "#/$defs/issueTransitionedData"}}},
    {"properties": {"type": {"const": "stage_completed"}, "data": {"$ref": "#/$defs/stageCompletedData"}}},
    {"properties": {"type": {"const": "operation_intended"}, "data": {"$ref": "#/$defs/pendingOperation"}}},
    {"properties": {"type": {"const": "operation_reconciled"}, "data": {"$ref": "#/$defs/operationReconciledData"}}},
    {"properties": {"type": {"const": "budget_reached"}, "data": {"$ref": "#/$defs/budgetReachedData"}}},
    {"properties": {"type": {"const": "kill_switch_detected"}, "data": {"$ref": "#/$defs/killSwitchDetectedData"}}},
    {"properties": {"type": {"const": "recovery_started"}, "data": {"$ref": "#/$defs/recoveryStartedData"}}},
    {"properties": {"type": {"const": "run_completed"}, "data": {"$ref": "#/$defs/terminalData"}}},
    {"properties": {"type": {"const": "run_failed"}, "data": {"$ref": "#/$defs/terminalData"}}},
    {"properties": {"type": {"const": "run_cancelled"}, "data": {"$ref": "#/$defs/terminalData"}}}
  ],
  "additionalProperties": false
}
