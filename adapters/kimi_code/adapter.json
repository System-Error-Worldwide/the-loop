{
  "schema_version": "1.0",
  "harness": "kimi_code",
  "display_name": "Kimi Code",
  "executables": [
    "kimi"
  ],
  "project_skill_roots": [
    ".kimi-code/skills",
    ".agents/skills"
  ],
  "user_skill_roots": [
    "$KIMI_CODE_HOME/skills",
    "$HOME/.agents/skills"
  ],
  "explicit_invocation": {
    "kind": "slash_command",
    "template": "/skill:<skill-name>",
    "behavior_status": "unverified"
  },
  "implicit_invocation": {
    "basis": "description",
    "behavior_status": "unverified",
    "requires_harness_probe": true
  },
  "permission_model": {
    "surface": "manual tool approval",
    "preserve_denial": true,
    "allow_bypass": false,
    "forbidden_flags": [
      "--yolo",
      "--yes",
      "--auto-approve",
      "--afk",
      "--auto",
      "--print"
    ]
  },
  "delegation": {
    "availability": "optional",
    "on_unavailable": "sequential",
    "behavior_status": "unverified"
  },
  "fallback": {
    "provider": "bundled",
    "mode": "sequential",
    "preserve_authority": true,
    "preserve_denial": true
  }
}
